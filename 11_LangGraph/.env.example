# Copy to `.env` in this folder, or reuse `10_RAG/.env` / a repo-root `.env`.
# Apps look in 11_LangGraph/.env, 10_RAG/.env, then the repo root.

OPENAI_API_KEY=sk-your-openai-key-here

# Optional — Notebook 03 web search. Falls back to DuckDuckGo (`ddgs`) if unset.
TAVILY_API_KEY=tvly-your-tavily-key-here

# Optional — LangSmith traces for the orchestrator and Studio.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_your-langsmith-key-here
LANGSMITH_PROJECT=helpdesk-orchestrator
