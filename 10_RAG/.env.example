# Copy this file to `.env` in this folder (10_RAG/.env) and fill in real keys.
# Never commit `.env`. Notebooks and apps load keys via python-dotenv.

# Required for most notebooks (01–16) and the Streamlit / FastAPI apps.
OPENAI_API_KEY=sk-your-openai-key-here

# Optional — only needed for the notebooks / features that use them.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
COHERE_API_KEY=your-cohere-key-here
PINECONE_API_KEY=your-pinecone-key-here
TAVILY_API_KEY=tvly-your-tavily-key-here
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# Optional observability (Notebook 11 and Session 11 apps).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_your-langsmith-key-here
LANGSMITH_PROJECT=zero-to-genai-rag
