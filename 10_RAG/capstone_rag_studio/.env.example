# RAG Studio backend environment — key NAMES only, never real secrets.
# Copy to `.env` (git-ignored) and fill in. The backend reads keys ONLY from the
# environment; the UI can never submit key values (Req 24.1).

# Required for core OpenAI-backed features (embeddings, generation, judges).
OPENAI_API_KEY=sk-your-openai-key-here

# Optional providers — absence disables the dependent options gracefully (Req 9.3).
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here   # unlocks Claude/Gemini/Llama via OpenAI-compatible endpoint
COHERE_API_KEY=your-cohere-key-here                 # unlocks Cohere Rerank
PINECONE_API_KEY=your-pinecone-key-here             # unlocks Pinecone vector store

# Optional: where RAG Studio keeps local state (defaults shown).
RAG_STUDIO_DB_PATH=./rag_studio.sqlite
RAG_STUDIO_UPLOAD_DIR=./uploads
RAG_STUDIO_CHROMA_DIR=./chroma_index
RAG_STUDIO_LOG_FILE=./rag_studio.log

# CORS: comma-separated origins allowed to call the backend (defaults to the Vite dev server).
RAG_STUDIO_CORS_ORIGINS=http://localhost:5173
