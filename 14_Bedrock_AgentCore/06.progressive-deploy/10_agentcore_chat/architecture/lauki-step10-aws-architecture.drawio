        <mxCell id="s8" value="8. Strands agent reply&#xa;→ ChatResponse.result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontSize=11;" parent="1" vertex="1">
