          <mxGeometry x="860" y="80" width="220" height="720" as="geometry" />
        </mxCell>

        <!-- Steps -->
        <mxCell id="s1" value="1. GET / → SPA + config.json&#xa;(S3 via OAC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="260" y="130" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2. USER_PASSWORD_AUTH&#xa;→ ID Token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="460" y="220" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3. Store JWT&#xa;sessionStorage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A30B5;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="60" y="310" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4. POST /api/chat&#xa;Authorization: Bearer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="60" y="400" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="5. Route /api/*&#xa;→ App Runner (no cache)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BC1356;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="260" y="400" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="6. Verify JWT via JWKS&#xa;aud = client id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7131F;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="670" y="400" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="7. InvokeAgentRuntime&#xa;session + actor_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="890" y="500" width="160" height="60" as="geometry" />
