# Copy to .env and fill in as you complete the README steps. Never commit .env.

OPENAI_API_KEY=sk-...
AWS_REGION=us-east-1

# Step 1 — paste YOUR Memory id from Console (us-east-1). Do not use a classmate's id.
# MEMORY_ID=

# Optional — better web_search quality
# TAVILY_API_KEY=

# Step 2 writes gateway-credentials.json locally. Prefer minting at shell time (see README):
# GATEWAY_URL=
# GATEWAY_TOKEN=
# IDENTITY_PROVIDER_NAME=gateway-cognito-m2m
# IDENTITY_AUTH_FLOW=M2M
# IDENTITY_SCOPES=lauki-demo-gateway/invoke

# Demo 5 — set from YOUR .bedrock_agentcore.yaml after deploy
# SUPPORT_RUNTIME_ARN=
# OPENAI_MODEL=gpt-4o-mini

# Bedrock + Guardrails (Strands Support production path)
# USE_BEDROCK=true
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# GUARDRAIL_ID=           # from: .venv/bin/python scripts/create_basic_guardrail.py
# GUARDRAIL_VERSION=1
